{
  "version": 2,
  "name": "io-openui-ao",
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/realtime/(.*)",
      "destination": "/api/realtime"
    },
    {
      "source": "/api/chat/(.*)",
      "destination": "/api/chat"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
