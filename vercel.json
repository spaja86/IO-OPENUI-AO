{
  "version": 2,
  "outputDirectory": "public",
  "routes": [
    { "src": "/bank/(.*)", "dest": "/bank/$1" },
    { "src": "/exchange/(.*)", "dest": "/exchange/$1" },
    { "src": "/company/(.*)", "dest": "/company/$1" },
    { "src": "/ai/(.*)", "dest": "/ai/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}