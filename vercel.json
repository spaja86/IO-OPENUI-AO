{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/bank/(.*)", "destination": "/bank/$1" },
    { "source": "/exchange/(.*)", "destination": "/exchange/$1" },
    { "source": "/company/(.*)", "destination": "/company/$1" },
    { "source": "/ai/(.*)", "destination": "/ai/$1" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}