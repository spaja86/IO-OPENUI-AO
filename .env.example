# .env.example

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Application Name
VITE_APP_NAME=your_app_name_here

# Application URL
VITE_APP_URL=your_app_url_here

# Vercel URL
VERCEL_URL=your_vercel_url_here

# Feature Flags
FEATURE_FLAG_X=true
FEATURE_FLAG_Y=false

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json